# Copy to `.env` (local) or add these in Vercel → Project → Settings → Environment Variables.
# Never commit a real `.env` – it is git-ignored.

# ──────────────────────────── Database (PostgreSQL) ────────────────────────────
# Local (docker compose up -d db):
DATABASE_URL="postgresql://gstrecon:gstrecon@localhost:5432/gstrecon?schema=public"
DATABASE_URL_UNPOOLED="postgresql://gstrecon:gstrecon@localhost:5432/gstrecon?schema=public"
#
# Supabase: DATABASE_URL = pooled connection string (port 6543) + "?pgbouncer=true&connection_limit=1"
#           DATABASE_URL_UNPOOLED   = direct or session-pooler connection string (port 5432) – used only for migrations
# Neon:     DATABASE_URL = pooled host (contains "-pooler") + "?sslmode=require"
#           DATABASE_URL_UNPOOLED   = the non-pooled host + "?sslmode=require"

# ──────────────────────────── Auth (NextAuth) ────────────────────────────
# Public URL of the app (Vercel: your production domain). Used for OAuth redirects and cookies.
NEXTAUTH_URL="http://localhost:3000"
# Signs sessions and OAuth `state`.   openssl rand -base64 32
NEXTAUTH_SECRET=""
# Public sign-up. By default only the FIRST account can register (bootstrap); afterwards admins add colleagues
# under Settings. Set to "true" only if you host the app for several unrelated firms.
ALLOW_SIGNUP=""

# ──────────────────────────── Encryption ────────────────────────────
# 32 random bytes, base64:  openssl rand -base64 32
# Encrypts Zoho OAuth tokens at rest (AES-256-GCM). If you lose it, saved tokens become unreadable and each
# GSTIN just has to be reconnected to Zoho. Rotate by changing it and reconnecting.
ENCRYPTION_KEY=""

# ──────────────────────────── Zoho Books (official OAuth 2.0) ────────────────────────────
# Create a "Server-based Application" in the Zoho API Console for YOUR data centre
# (India: https://api-console.zoho.in · US: https://api-console.zoho.com · EU: https://api-console.zoho.eu).
# "Authorized Redirect URIs" must contain exactly ZOHO_REDIRECT_URI.
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REDIRECT_URI="http://localhost:3000/api/zoho/callback"
# Default data centre shown in the UI: in | com | eu | com.au | jp | ca | sa | com.cn
ZOHO_DC="in"
# Read-only scopes are all this app needs.
ZOHO_SCOPES="ZohoBooks.bills.READ,ZohoBooks.settings.READ"

# ──────────────────────────── Scheduled Zoho sync (Vercel Cron) ────────────────────────────
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/zoho-sync (see vercel.json).
# Leave empty to disable the endpoint.   openssl rand -hex 24
CRON_SECRET=""

# ──────────────────────────── GSTR-2B provider (authorised GSP / GSTN API ONLY) ────────────────────────────
# none (default) → upload the GSTR-2B Excel/JSON downloaded from the portal, or the CSV template
# mock           → built-in fabricated data for demos (disabled in production unless GSP_ALLOW_MOCK_IN_PRODUCTION=true)
# http           → generic HTTPS adapter for a GSP that returns the official GSTR-2B JSON (settings below)
# <your id>      → a custom adapter registered in src/lib/gsp/registry.ts (docs/INTEGRATIONS.md)
# The app never asks for, or stores, GST portal usernames or passwords.
GSP_PROVIDER="none"
GSP_ALLOW_MOCK_IN_PRODUCTION=""
GSP_HTTP_NAME=""
GSP_HTTP_BASE_URL=""
# {gstin} {period}=MMYYYY {year} {month} are substituted.
GSP_HTTP_PATH="/gstr2b?gstin={gstin}&period={period}"
GSP_HTTP_METHOD="GET"
GSP_HTTP_AUTH_HEADER="Authorization"
GSP_HTTP_AUTH_SCHEME="Bearer"
GSP_HTTP_API_KEY=""
# Optional JSON object of extra static headers, e.g. {"x-client-id":"abc"}
GSP_HTTP_EXTRA_HEADERS=""
# Optional dot-path to the GSTR-2B document inside the response, e.g. "result"
GSP_HTTP_RESPONSE_PATH=""

# ──────────────────────────── Upload limits ────────────────────────────
# Vercel serverless functions accept request bodies up to 4.5 MB, so keep MAX_UPLOAD_MB at 4 or below there.
MAX_UPLOAD_MB="4"
MAX_UPLOAD_ROWS="20000"

# ──────────────────────────── Docker Compose only ────────────────────────────
POSTGRES_USER="gstrecon"
POSTGRES_PASSWORD="gstrecon"
POSTGRES_DB="gstrecon"
POSTGRES_PORT="5432"
APP_PORT="3000"

# ──────────────────────────── Demo data (npm run db:seed) ────────────────────────────
# Password for the demo users (priya@ / rahul@ / anita@sharma-ca.example). The seed refuses to run in production.
SEED_PASSWORD="DemoPass#2026"
